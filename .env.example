# Public browser configuration. Values are safe to expose only when Supabase
# Row Level Security policies are enabled and tested.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Explicit local demonstration mode. Never enable this for a production deploy.
VITE_TRACT_DEMO_MODE=true

# Server-only secrets belong in the deployment secret store, never in this file.
SUPABASE_SERVICE_ROLE_KEY=
TRACT_LOG_LEVEL=info
